# =====================================================
# Cache Control for Vite SPA
# =====================================================

<IfModule mod_headers.c>

    # IMPORTANT:
    # Never cache index.html.
    # This ensures users always get the latest Vite build.
    <Files "index.html">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </Files>

    # Vite hashed assets can be cached for 1 year.
    <FilesMatch "\.(js|css|woff|woff2|ttf|eot|otf|png|jpg|jpeg|gif|svg|ico|webp)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

</IfModule>

# =====================================================
# SPA Routing
# React Router routes → index.html
# =====================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Don't rewrite existing files/directories
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Send all other routes to React
    RewriteRule ^ index.html [L]
</IfModule>
